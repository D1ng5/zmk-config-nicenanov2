#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "keys_de.h"

/ {
    keymap {
        compatible = "zmk,keymap";

        /* LAYER 0: default (erstmal simpel, aber mit DE_* möglich) */

        default_layer {
            bindings = <
&kp Q  &kp W      &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O      &kp P
&kp A  &kp S      &kp D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L      &kp DE_OE
&kp Z  &kp X      &kp C  &kp V  &kp B    &kp N  &kp M  &kp DE_AE  &kp DE_UE  &kp DE_SZ
&to 1  &kp LCTRL                                                  &kp SPACE  &trans
            >;
        };
    };
};
